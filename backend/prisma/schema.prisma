datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. ORGANIZATIONAL HIERARCHY & MULTI-OWNER RBAC
// ============================================================================

enum UserRoleType {
  MANAGING_DIRECTOR
  DIRECTOR_PARTNER
  GENERAL_MANAGER
  MERCHANDISER
  PPC_PLANNER
  STORE_INCHARGE
  CUTTING_MASTER
  SEWING_SUPERVISOR
  FINISHING_INCHARGE
  PACKING_SHIPPING_OFFICER
  ACCOUNTS_HR_EXECUTIVE
  QUALITY_MANAGER
}

enum WorkstationNode {
  NODE_01_MERCHANDISING
  NODE_02_PPC_PLANNING
  NODE_03_STORE
  NODE_04_CUTTING
  NODE_05_SEWING
  NODE_06_FINISHING
  NODE_07_PACKING_DISPATCH
  NODE_08_ACCOUNTS_HR_1
  NODE_09_ACCOUNTS_HR_2
  NODE_10_ADMIN_MD
  NODE_11_ADMIN_PARTNER
  NODE_12_ADMIN_GM
}

model Company {
  id              String      @id @default(uuid())
  name            String
  code            String      @unique
  gstNumber       String?     @unique
  panNumber       String?
  factories       Factory[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Factory {
  id              String      @id @default(uuid())
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  name            String
  code            String      @unique
  location        String
  departments     Department[]
  warehouses      Warehouse[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Department {
  id              String      @id @default(uuid())
  factoryId       String
  factory         Factory     @relation(fields: [factoryId], references: [id])
  name            String
  code            String
  employees       Employee[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([factoryId, code])
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  email           String           @unique
  passwordHash    String
  fullName        String
  roleType        UserRoleType
  assignedNode    WorkstationNode?
  isActive        Boolean          @default(true)
  isSuperAdmin    Boolean          @default(false)
  lastLoginAt     DateTime?
  auditLogs       AuditLog[]
  createdOrders   Order[]          @relation("OrderCreator")
  approvals       ApprovalAction[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([roleType, isActive])
}

model AuditLog {
  id              String           @id @default(uuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
  node            WorkstationNode?
  module          String
  action          String
  entityType      String
  entityId        String
  details         Json?
  ipAddress       String?
  timestamp       DateTime         @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
}

// ============================================================================
// 2. PARTNERS: BUYERS (CUSTOMERS) & SUPPLIERS (VENDORS)
// ============================================================================

model Customer {
  id              String      @id @default(uuid())
  code            String      @unique
  companyName     String
  contactPerson   String
  email           String
  phone           String
  gstNumber       String?     @unique
  billingAddress  String
  shippingAddress String
  creditLimit     Decimal     @default(0.00) @db.Decimal(14, 2)
  outstandingDue  Decimal     @default(0.00) @db.Decimal(14, 2)
  orders          Order[]
  invoices        Invoice[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Supplier {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  category        String
  contactPerson   String
  phone           String
  email           String?
  gstNumber       String?         @unique
  bankAccountNo   String?
  bankIfscCode    String?
  bankName        String?
  fabricRolls     FabricRoll[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ============================================================================
// 3. STYLE MASTER & BILL OF MATERIALS (BOM)
// ============================================================================

model Style {
  id              String      @id @default(uuid())
  styleNumber     String      @unique
  styleName       String
  category        String
  buyerCode       String
  season          String?
  samValue        Decimal     @db.Decimal(6, 2)
  targetCost      Decimal     @db.Decimal(12, 2)
  bomItems        BOMItem[]
  orders          Order[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model BOMItem {
  id               String   @id @default(uuid())
  styleId          String
  style            Style    @relation(fields: [styleId], references: [id])
  itemCategory     String
  itemDescription  String
  consumptionPerPc Decimal  @db.Decimal(8, 4)
  unitOfMeasure    String
  bufferPercentage Decimal  @default(3.00) @db.Decimal(5, 2)
}

// ============================================================================
// 4. ORDERS & 22-STAGE MANUFACTURING WORKFLOW
// ============================================================================

enum WorkflowStage {
  ORDER_CONFIRMED
  FABRIC_INWARD_GRN
  FPT_TESTING
  PPE_GPT_TESTING
  SIZE_SET_SAMPLE_APPROVAL
  CUTTING_COMMENCED
  RAW_MATERIAL_ISSUED
  CUT_DOWN_COMPLETED
  CUT_ORDER_REPORT_GENERATED
  STITCHING_LINE_ALLOCATED
  STITCHING_ENDLINE_CHECKING
  STITCHING_ALTERATION_REPAIR
  STITCHING_DAMAGED_SCRAP
  FINISHING_FLOOR_RECEIVED
  STAGE_1_BARTACK_EYELET_BUTTON
  STAGE_2_THREAD_TRIMMING
  STAGE_3_PRESS_1
  STAGE_4_INITIAL_QC_CHECK
  STAGE_5_FINAL_PRESS
  STAGE_6_FINAL_QA_AUDIT
  PACKING_AND_CARTONING
  DISPATCH_AND_SHIPPING
}

enum QualityGateStatus {
  NOT_APPLICABLE
  PENDING
  PASSED
  FAILED
}

model Order {
  id                 String                 @id @default(uuid())
  orderNumber        String                 @unique
  buyerPoNumber      String
  customerId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  styleId            String
  style              Style                  @relation(fields: [styleId], references: [id])
  totalQuantity      Int
  unitPrice          Decimal                @db.Decimal(10, 2)
  totalOrderValue    Decimal                @db.Decimal(14, 2)
  targetDeliveryDate DateTime
  currentStage       WorkflowStage          @default(ORDER_CONFIRMED)
  
  fptStatus          QualityGateStatus      @default(PENDING)
  gptStatus          QualityGateStatus      @default(PENDING)
  sizeSetRequired    Boolean                @default(true)
  sizeSetStatus      QualityGateStatus      @default(PENDING)

  createdById        String
  createdBy          User                   @relation("OrderCreator", fields: [createdById], references: [id])
  
  sizeBreakups       OrderSizeBreakup[]
  stageHistory       WorkflowStageHistory[]
  fptRecords         FptRecord[]
  gptRecords         GptRecord[]
  sizeSetApprovals   SizeSetApproval[]
  cutReports         CutOrderReport[]
  cutBundles         CutBundle[]
  endlineLogs        StitchingEndlineLog[]
  finishingPipelines FinishingPipelineLog[]
  pieceWorkTickets   PieceWorkTicket[]
  invoices           Invoice[]
  
  syncStatus         String                 @default("SYNCED")
  cloudVersion       Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([customerId, styleId])
  @@index([currentStage])
}

model OrderSizeBreakup {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  colorName   String
  sizeName    String
  quantity    Int
  cutQuantity Int      @default(0)

  @@unique([orderId, colorName, sizeName])
}

model WorkflowStageHistory {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStage      WorkflowStage
  toStage        WorkflowStage
  transitionedBy String
  terminalNode   WorkstationNode
  comments       String?
  timestamp      DateTime        @default(now())

  @@index([orderId, timestamp])
}

// ============================================================================
// 5. QUALITY TESTING GATES (FPT, GPT & SIZE SET)
// ============================================================================

model FptRecord {
  id              String            @id @default(uuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id])
  fabricLotNo     String
  shrinkageWarp   Decimal           @db.Decimal(5, 2)
  shrinkageWeft   Decimal           @db.Decimal(5, 2)
  rubbingDry      Decimal           @db.Decimal(4, 2)
  rubbingWet      Decimal           @db.Decimal(4, 2)
  washingFastness Decimal           @db.Decimal(4, 2)
  actualGsm       Decimal           @db.Decimal(6, 2)
  status          QualityGateStatus
  remarks         String?
  testedBy        String
  testedAt        DateTime          @default(now())

  @@index([orderId])
}

model GptRecord {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id])
  washAppearance String
  seamStrengthKg Decimal           @db.Decimal(6, 2)
  torquePercent  Decimal           @db.Decimal(5, 2)
  status         QualityGateStatus
  remarks        String?
  testedBy       String
  testedAt       DateTime          @default(now())

  @@index([orderId])
}

model SizeSetApproval {
  id            String            @id @default(uuid())
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  sampleSize    String
  buyerComments String?
  status        QualityGateStatus
  approvedBy    String
  approvedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([orderId])
}

// ============================================================================
// 6. PRODUCTION: CUTTING, STITCHING & FINISHING
// ============================================================================

model CutOrderReport {
  id                String    @id @default(uuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id])
  reportNumber      String    @unique
  pliesCut          Int
  totalPiecesCut    Int
  actualFabMeters   Decimal   @db.Decimal(10, 2)
  consumptionPerPc  Decimal   @db.Decimal(8, 4)
  wastagePercent    Decimal   @db.Decimal(5, 2)
  bundleStartNo     Int
  bundleEndNo       Int
  cuttingMasterName String
  createdAt         DateTime  @default(now())
}

model CutBundle {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  bundleNumber    String
  sizeName        String
  colorName       String
  piecesCount     Int
  barcode         String    @unique
  currentLocation String
  isCompleted     Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([orderId, bundleNumber])
}

model StitchingEndlineLog {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  productionLineId String
  inspectedPieces  Int
  goodPassed       Int
  underAlteration  Int
  repairedPieces   Int
  damagedScrap     Int
  inspectorName    String
  shiftName        String
  recordedAt       DateTime  @default(now())

  @@index([orderId, recordedAt])
}

model FinishingPipelineLog {
  id                  String    @id @default(uuid())
  orderId             String    @unique
  order               Order     @relation(fields: [orderId], references: [id])
  bartackButtonPassed Int       @default(0)
  threadCutPassed     Int       @default(0)
  press1Passed        Int       @default(0)
  initialCheckPassed  Int       @default(0)
  initialCheckFailed  Int       @default(0)
  repairedToPress     Int       @default(0)
  finalPressPassed    Int       @default(0)
  finalQaPassed       Int       @default(0)
  damagedScrapTotal   Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

// ============================================================================
// 7. INVENTORY: PERPETUAL DOUBLE-ENTRY STOCK LEDGER
// ============================================================================

model Warehouse {
  id          String             @id @default(uuid())
  factoryId   String
  factory     Factory            @relation(fields: [factoryId], references: [id])
  name        String
  code        String             @unique
  fabricRolls FabricRoll[]
  stockLedger StockLedgerEntry[]
}

model FabricRoll {
  id            String     @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id])
  supplierId    String
  supplier      Supplier   @relation(fields: [supplierId], references: [id])
  rollBarcode   String     @unique
  fabricType    String
  shadeLot      String
  totalMeters   Decimal    @db.Decimal(10, 2)
  balanceMeters Decimal    @db.Decimal(10, 2)
  costPerMeter  Decimal    @db.Decimal(10, 2)
  grnNumber     String
  receivedAt    DateTime   @default(now())

  @@index([rollBarcode])
  @@index([shadeLot])
}

model StockLedgerEntry {
  id              String    @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  itemCode        String
  itemCategory    String
  transactionType String
  quantityDelta   Decimal   @db.Decimal(12, 4)
  unitCost        Decimal   @db.Decimal(12, 2)
  totalValue      Decimal   @db.Decimal(14, 2)
  referenceDoc    String
  timestamp       DateTime  @default(now())

  @@index([itemCode, timestamp])
}

// ============================================================================
// 8. HRMS, ATTENDANCE & DUAL-WAGE LABOR
// ============================================================================

enum WageModel {
  PIECE_RATE
  HOURLY_WAGE
  MONTHLY_SALARIED
  DAILY_WAGE
}

model Employee {
  id                String              @id @default(uuid())
  employeeCode      String              @unique
  fullName          String
  departmentId      String
  department        Department          @relation(fields: [departmentId], references: [id])
  designation       String
  wageModel         WageModel
  baseSalaryMonthly Decimal?            @db.Decimal(12, 2)
  baseHourlyRate    Decimal?            @db.Decimal(8, 2)
  defaultPieceRate  Decimal?            @db.Decimal(8, 2)
  
  bankName          String
  bankAccountNo     String
  ifscCode          String
  panNumber         String?
  uanNumber         String?
  isActive          Boolean             @default(true)
  
  attendanceLogs    AttendanceDaily[]
  pieceWorkTickets  PieceWorkTicket[]
  hourlyWorkLogs    HourlyWorkLog[]
  payrollSlips      PayrollSlip[]
  payoutTxns        PayoutTransaction[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([employeeCode, wageModel])
}

model AttendanceDaily {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  workDate      DateTime  @db.Date
  inTime        DateTime?
  outTime       DateTime?
  totalHours    Decimal   @default(0.00) @db.Decimal(5, 2)
  overtimeHours Decimal   @default(0.00) @db.Decimal(5, 2)
  status        String
  source        String
  isValidated   Boolean   @default(false)
  validatedBy   String?

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model PieceWorkTicket {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  operationName   String
  piecesSubmitted Int
  qcPassedPieces  Int
  defectivePieces Int       @default(0)
  ratePerPiece    Decimal   @db.Decimal(8, 2)
  grossAmount     Decimal   @db.Decimal(12, 2)
  workDate        DateTime  @db.Date
  supervisorName  String
  createdAt       DateTime  @default(now())

  @@index([employeeId, workDate])
  @@index([orderId])
}

model HourlyWorkLog {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  workDate      DateTime  @db.Date
  lineAllocated String
  regularHours  Decimal   @db.Decimal(5, 2)
  overtimeHours Decimal   @db.Decimal(5, 2)
  hourlyRate    Decimal   @db.Decimal(8, 2)
  otMultiplier  Decimal   @default(1.50) @db.Decimal(4, 2)
  totalCost     Decimal   @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())

  @@index([employeeId, workDate])
}

// ============================================================================
// 9. PAYROLL REGISTER & BANKING PAYOUT ABSTRACTION
// ============================================================================

enum PayrollStatus {
  DRAFT
  CALCULATED
  LOCKED
  DISBURSEMENT_INITIATED
  PARTIALLY_DISBURSED
  FULLY_PAID
}

model PayrollPeriod {
  id              String         @id @default(uuid())
  periodCode      String         @unique
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  totalGrossPay   Decimal        @default(0.00) @db.Decimal(14, 2)
  totalDeductions Decimal        @default(0.00) @db.Decimal(14, 2)
  totalNetPay     Decimal        @default(0.00) @db.Decimal(14, 2)
  status          PayrollStatus  @default(DRAFT)
  payrollSlips    PayrollSlip[]
  payoutBatches   PayoutBatch[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PayrollSlip {
  id               String             @id @default(uuid())
  periodId         String
  period           PayrollPeriod      @relation(fields: [periodId], references: [id])
  employeeId       String
  employee         Employee           @relation(fields: [employeeId], references: [id])
  wageModel        WageModel
  presentDays      Decimal            @db.Decimal(5, 2)
  overtimeHours    Decimal            @db.Decimal(5, 2)
  
  basicOrPiecePay  Decimal            @db.Decimal(12, 2)
  overtimePay      Decimal            @default(0.00) @db.Decimal(12, 2)
  allowances       Decimal            @default(0.00) @db.Decimal(12, 2)
  grossPay         Decimal            @db.Decimal(12, 2)
  
  pfDeduction      Decimal            @default(0.00) @db.Decimal(10, 2)
  esiDeduction     Decimal            @default(0.00) @db.Decimal(10, 2)
  advanceDeduction Decimal            @default(0.00) @db.Decimal(10, 2)
  otherDeductions  Decimal            @default(0.00) @db.Decimal(10, 2)
  totalDeductions  Decimal            @default(0.00) @db.Decimal(12, 2)
  
  netPayable       Decimal            @db.Decimal(12, 2)
  isLocked         Boolean            @default(false)
  isDisbursed      Boolean            @default(false)
  
  payoutTxnId      String?
  payoutTxn        PayoutTransaction? @relation(fields: [payoutTxnId], references: [id])

  @@unique([periodId, employeeId])
}

enum PayoutStatus {
  CREATED
  SUBMITTED
  PROCESSING
  SUCCESS
  FAILED
  RECONCILED
}

model PayoutBatch {
  id             String              @id @default(uuid())
  batchNumber    String              @unique
  periodId       String
  period         PayrollPeriod       @relation(fields: [periodId], references: [id])
  bankProvider   String
  totalEmployees Int
  totalAmount    Decimal             @db.Decimal(14, 2)
  status         PayoutStatus        @default(CREATED)
  idempotencyKey String              @unique
  approvedById   String
  approvedBy     String
  transactions   PayoutTransaction[]
  journalEntryId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model PayoutTransaction {
  id              String        @id @default(uuid())
  batchId         String
  batch           PayoutBatch   @relation(fields: [batchId], references: [id])
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  beneficiaryAcc  String
  beneficiaryIfsc String
  status          PayoutStatus  @default(CREATED)
  bankReference   String?
  utrNumber       String?
  errorCode       String?
  errorMessage    String?
  attempts        Int           @default(0)
  disbursedAt     DateTime?
  payrollSlips    PayrollSlip[]

  @@unique([batchId, employeeId])
  @@index([utrNumber])
  @@index([status])
}

// ============================================================================
// 10. GENERAL DOUBLE-ENTRY ACCOUNTS LEDGER
// ============================================================================

model JournalEntry {
  id            String             @id @default(uuid())
  voucherNumber String             @unique
  date          DateTime           @db.Date
  narration     String
  referenceType String
  referenceId   String?
  lines         JournalEntryLine[]
  createdAt     DateTime           @default(now())
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  accountName    String
  debitAmount    Decimal      @default(0.00) @db.Decimal(14, 2)
  creditAmount   Decimal      @default(0.00) @db.Decimal(14, 2)

  @@index([accountCode])
}

// ============================================================================
// 11. INVOICING & PURCHASE ORDERS
// ============================================================================

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  invoiceDate    DateTime @db.Date
  subTotal       Decimal  @db.Decimal(14, 2)
  cgstAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  sgstAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  igstAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  grandTotal     Decimal  @db.Decimal(14, 2)
  paidAmount     Decimal  @default(0.00) @db.Decimal(14, 2)
  paymentStatus  String
  eWayBillNumber String?
  createdAt      DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  poNumber    String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  totalAmount Decimal  @db.Decimal(14, 2)
  status      String
  createdAt   DateTime @default(now())
}

// ============================================================================
// 12. FACTORY-TO-CLOUD DURABLE SYNCHRONIZATION
// ============================================================================

enum SyncOperation {
  INSERT
  UPDATE
  DELETE
}

model SyncOutbox {
  id           BigInt          @id @default(autoincrement())
  entityName   String
  entityId     String
  operation    SyncOperation
  payload      Json
  version      Int
  originNode   WorkstationNode
  isDispatched Boolean         @default(false)
  dispatchedAt DateTime?
  retryCount   Int             @default(0)
  lastError    String?
  createdAt    DateTime        @default(now())

  @@index([isDispatched, id])
}

model SyncCheckpoint {
  id                 String   @id @default(uuid())
  clientNodeId       String   @unique
  lastSyncedOutboxId BigInt   @default(0)
  lastSyncAt         DateTime @default(now())
}

model SyncConflictLog {
  id           String    @id @default(uuid())
  entityName   String
  entityId     String
  cloudPayload Json
  localPayload Json
  resolution   String
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

// ============================================================================
// 13. MULTI-LEVEL APPROVAL WORKFLOW
// ============================================================================

model ApprovalRequest {
  id            String           @id @default(uuid())
  referenceType String
  referenceId   String
  description   String
  requestedBy   String
  status        String
  actions       ApprovalAction[]
  createdAt     DateTime         @default(now())
}

model ApprovalAction {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  action    String
  comments  String?
  actionAt  DateTime        @default(now())
}
